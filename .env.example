# Copie para .env no desenvolvimento local. Em produção, defina no painel do Railway (Variables).
# Nenhum segredo tem valor padrão: o servidor não sobe sem eles.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/menezesgestao
# Banco só para testes (apagado a cada execução; o nome precisa conter "teste").
DATABASE_URL_TESTE=postgres://postgres:postgres@localhost:5432/menezesgestao_teste

# Gere cada um com: openssl rand -hex 32
SESSION_SECRET=
CRM_CHAVE=

# Endereço público (links de convite e de senha). Obrigatório em produção.
APP_URL=http://localhost:3000
PRODUTO_NOME=Menezes Gestão

# Opcional. Sem SMTP_URL, os e-mails ficam na caixa de demonstração: npm run caixa-de-saida
# Formato: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
EMAIL_REMETENTE=

# Senha das pessoas criadas por npm run dados:exemplo (pelo menos 10 caracteres).
SENHA_EXEMPLO=
